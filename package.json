{
  "name": "web-agent",
  "version": "0.2.0",
  "description": "A local, recoverable Web workspace for Codex, with a compatible Claude Code MCP entry.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "claude-code",
    "mcp",
    "model-context-protocol",
    "agent",
    "human-in-the-loop",
    "ui"
  ],
  "bin": {
    "web-agent-mcp": "src/mcp.js"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node src/main.js",
    "test": "node --test test/*.test.js",
    "test:real": "node scripts/smoke-codex.mjs",
    "setup": "node scripts/install.mjs",
    "uninstall": "node scripts/install.mjs --uninstall",
    "mcp": "node src/mcp.js",
    "demo": "node demo/demo.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "^8.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lzclzclzclzclzclzc/web-agent"
  }
}
